{
  "filters": {
    "comments": true
  },
  "rules": {
    "preset-ja-technical-writing": {
      "sentence-length": false,
      "no-doubled-joshi": { "allow": ["も", "にも"] },
      "no-mix-dearu-desumasu": { "preferInHeader": "", "preferInBody": "である", "preferInList": "である", "strict": false }
    },
    "@textlint-ja/preset-ai-writing": {
      "no-ai-list-formatting": { "disableBoldListItems": true },
      "no-ai-emphasis-patterns": { "disableInfoPatterns": true },
      "ai-tech-writing-guideline": false
    }
  }
}
