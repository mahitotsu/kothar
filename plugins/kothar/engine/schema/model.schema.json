{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kothar:schema:model",
  "title": "Kothar のモデル",
  "type": "object",
  "required": ["vocabulary", "grammar", "nodes", "edges"],
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "attrs": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "properties": {
    "vocabulary": { "description": "語彙のファイルのパス（このモデルのファイルからの相対パス）", "type": "string" },
    "grammar": { "description": "文法のファイルのパス（このモデルのファイルからの相対パス）", "type": "string" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string" },
          "attrs": { "$ref": "#/$defs/attrs" },
          "pin": {
            "description": "ノードの中心を固定する座標",
            "type": "object",
            "required": ["x", "y"],
            "additionalProperties": false,
            "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "members"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string" },
          "attrs": { "$ref": "#/$defs/attrs" },
          "members": { "type": "array", "items": { "$ref": "#/$defs/id" }, "minItems": 1 }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "kind"],
        "additionalProperties": false,
        "properties": {
          "from": { "$ref": "#/$defs/id" },
          "to": { "$ref": "#/$defs/id" },
          "kind": { "type": "string" },
          "label": { "type": "string" }
        }
      }
    }
  }
}
